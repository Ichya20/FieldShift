{
  "openapi": "3.1.0",
  "info": {
    "title": "FieldShift API",
    "description": "Eksplorasi rotasi dengan data publik Yogyakarta–Klaten. Hasil parsial dan asumsi dinyatakan eksplisit; belum tervalidasi agronomi lokal.",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/v1/catalog": {
      "get": {
        "summary": "Catalog",
        "operationId": "catalog_api_v1_catalog_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/v1/locations": {
      "get": {
        "summary": "Locations",
        "operationId": "locations_api_v1_locations_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/v1/crops": {
      "get": {
        "summary": "Crops",
        "operationId": "crops_api_v1_crops_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/v1/input-contract": {
      "get": {
        "summary": "Input Contract",
        "operationId": "input_contract_api_v1_input_contract_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/v1/context": {
      "post": {
        "summary": "Context",
        "operationId": "context_api_v1_context_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ContextRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/compare": {
      "post": {
        "summary": "Compare",
        "operationId": "compare_api_v1_compare_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CompareRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/demo": {
      "get": {
        "summary": "Demo",
        "operationId": "demo_api_v1_demo_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CompareRequest": {
        "properties": {
          "location": {
            "$ref": "#/components/schemas/Location"
          },
          "document": {
            "additionalProperties": true,
            "type": "object",
            "title": "Document"
          },
          "input_kind": {
            "type": "string",
            "enum": [
              "scenario_assumption",
              "user_reported"
            ],
            "title": "Input Kind"
          },
          "assumptions": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 30,
            "title": "Assumptions"
          },
          "slot_inputs": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/SlotInput"
                },
                "type": "array",
                "maxItems": 3
              },
              {
                "type": "null"
              }
            ],
            "title": "Slot Inputs"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "location",
          "input_kind"
        ],
        "title": "CompareRequest"
      },
      "ContextRequest": {
        "properties": {
          "location": {
            "$ref": "#/components/schemas/Location"
          },
          "window": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Window"
              },
              {
                "type": "null"
              }
            ]
          },
          "time_mode": {
            "type": "string",
            "enum": [
              "historical_replay",
              "historical_analogue_not_forecast",
              "recent_partial"
            ],
            "title": "Time Mode",
            "default": "historical_replay"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "location"
        ],
        "title": "ContextRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Location": {
        "properties": {
          "example_id": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "klaten_cropland_primary",
                  "klaten_cropland_candidate"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Example Id"
          },
          "longitude": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 180.0,
                "minimum": -180.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Longitude"
          },
          "latitude": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 90.0,
                "minimum": -90.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Latitude"
          },
          "climate_context_id": {
            "anyOf": [
              {
                "type": "string",
                "const": "power_regional_yogyakarta"
              },
              {
                "type": "null"
              }
            ],
            "title": "Climate Context Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "Location"
      },
      "SlotInput": {
        "properties": {
          "production_method": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "direct_seeded",
                  "transplanted"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Production Method"
          },
          "sowing_date": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sowing Date"
          },
          "transplanting_date": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Transplanting Date"
          },
          "nursery_off_main_field": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Nursery Off Main Field"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "SlotInput"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "Window": {
        "properties": {
          "start_date": {
            "type": "string",
            "title": "Start Date"
          },
          "end_exclusive": {
            "type": "string",
            "title": "End Exclusive"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "start_date",
          "end_exclusive"
        ],
        "title": "Window"
      }
    }
  }
}
